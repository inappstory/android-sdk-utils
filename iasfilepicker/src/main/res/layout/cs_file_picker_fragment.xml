<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#000000"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:orientation="horizontal"
        android:id="@+id/partialAccessLayout"
        android:visibility="gone"
        android:gravity="center_vertical"
        android:layout_margin="8dp"
        android:layout_height="wrap_content">
        <TextView
            android:layout_width="match_parent"
            android:layout_weight="1"
            android:layout_marginRight="8dp"
            android:id="@+id/partialAccessHint"
            android:text="Your app has only partial access to gallery"
            android:layout_height="wrap_content"/>
        <androidx.appcompat.widget.AppCompatButton
            android:layout_width="100dp"
            android:background="@drawable/cs_button_background"
            android:id="@+id/manageAccess"
            android:gravity="center"
            android:textAllCaps="false"
            android:text="Manage"
            android:textColor="@color/white"
            android:layout_height="36dp"/>
    </LinearLayout>
    <com.inappstory.utils.iasfilepicker.file.FilePreviewsList
        android:layout_width="match_parent"
        android:layout_below="@id/partialAccessLayout"
        android:id="@+id/previews"
        android:background="@color/black"
        android:layout_height="match_parent"/>
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:elevation="8dp"
        app:maxImageSize="36dp"
        android:visibility="invisible"
        android:id="@+id/upload"
        android:contentDescription="upload"
        android:src="@drawable/cs_approve_upload"
        android:layout_marginRight="40dp"
        android:layout_marginBottom="60dp"
        app:backgroundTint="@color/white"
        app:tint="@color/black"
        android:tint="@color/black"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:visibility="gone"
        android:layout_height="match_parent">
        <LinearLayout
            android:id="@+id/bsLayout"
            android:background="@color/white"
            android:layout_width="match_parent"
            app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
            android:orientation="vertical"
            android:layout_height="wrap_content">
            <View
                android:layout_width="match_parent"
                android:background="#FF0000"
                android:layout_height="100dp"/>
            <View
                android:layout_width="match_parent"
                android:background="#00FF00"
                android:layout_height="100dp"/>
        </LinearLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</RelativeLayout>
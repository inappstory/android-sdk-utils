<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <LinearLayout
        android:id="@+id/partialAccessLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/partialAccessHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:layout_marginRight="8dp"
            android:layout_weight="1"
            android:text="Your app has only partial access to gallery" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/manageAccess"
            android:layout_width="100dp"
            android:layout_height="36dp"
            android:background="@drawable/cs_button_background"
            android:gravity="center"
            android:text="Manage"
            android:textAllCaps="false"
            android:textColor="@color/white" />
    </LinearLayout>

    <com.inappstory.utils.iasfilepicker.file.FilePreviewsList
        android:id="@+id/previews"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/partialAccessLayout"
        android:background="@color/black" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/upload"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginRight="40dp"
        android:layout_marginBottom="60dp"
        android:contentDescription="upload"
        android:elevation="8dp"
        android:src="@drawable/cs_approve_upload"
        android:tint="@color/black"
        android:visibility="invisible"
        app:backgroundTint="@color/white"
        app:maxImageSize="36dp"
        app:tint="@color/black" />

    <com.inappstory.utils.iasfilepicker.file.AccessBottomSheetDialog
        android:layout_width="match_parent"
        android:id="@+id/accessDialog"
        android:layout_height="match_parent" />
</RelativeLayout>